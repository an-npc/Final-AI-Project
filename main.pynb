"""
Self-play REINFORCE for No-Limit Texas Hold'em, built to deploy on the Bayou Poker server
(https://github.com/binaya07/ai-poker-server)
=========================================================================================

What makes this deployable:
  * the training engine copies the server's rules (app/engine.py): heads-up button posts the
    small blind, minimum-raise / short-all-in reopening via "acted_at", uncalled bets returned,
    burn cards, side pots and odd-chip order. Stacks reset to `starting_stack` every hand,
    exactly like the server (default 1000 chips, blinds 10/20 = 50 BB).
  * every hand is dealt at a random table size between min_players and max_players, and the
    observation has fixed slots for up to 20 seats (the server's maximum), so one network
    plays any table size the server ends up with.
  * the observation uses ONLY what the server's `state` message shows. The training engine
    and the live bot both build the same `View` object and feed it to the same `encode()`,
    so there is no train/deploy mismatch to get wrong by hand.
  * actions are translated into the server's JSON ({"action":"raise","amount":<street total>}).
  * `play` mode in this same file connects to the server over WebSocket and plays.

Train (Google Colab)
--------------------
  Cell 1:  from google.colab import drive; drive.mount('/content/drive')
  Cell 2:  paste this file (or upload it and run:  !python poker_selfplay.py)
  Output:  <save_dir>/policy_latest.pt   (download this file for the bot)

Play on the server
------------------
  pip install torch numpy websockets
  python poker_selfplay.py play group-1 ws://SERVER_HOST:8000/ws --policy policy_latest.pt
  (options: --name "Group 1 Bot", --greedy to always pick the most likely action)

Engine self-test only:   python poker_selfplay.py selftest

Edit the CONFIG block below to change table sizes, run length, etc. If the instructor changes
config.toml (stack or blinds), change starting_stacks / small_blind / big_blind to match.
"""

import os, sys, time, math, random, csv, json, asyncio, argparse
from dataclasses import dataclass, asdict

import numpy as np
import torch
import torch.nn as nn
import torch.nn.functional as F


# ----------------------------------------------------------------------------
# CONFIG
# ----------------------------------------------------------------------------
@dataclass
class Config:
    # --- table: match the server's config.toml -------------------------------
    small_blind: int = 10
    big_blind: int = 20
    starting_stacks: tuple = (1000,)   # chips at the start of every hand; add e.g. 800, 1200 for robustness
    min_players: int = 2               # each training hand picks a table size uniformly in [min, max];
    max_players: int = 13              # set both to the real table size if you know it
    # --- self-play ------------------------------------------------------------
    num_tables: int = 128
    batch_decisions: int = 8192        # decisions collected per policy update
    minibatch: int = 2048
    lr: float = 1e-4
    entropy_coef: float = 0.03
    entropy_coef_final: float = 0.005
    entropy_decay_updates: int = 20000
    value_coef: float = 0.5
    grad_clip: float = 1.0
    return_scale: float = 20.0         # value head predicts (chips won in BB) / return_scale
    hidden: int = 512
    snapshot_every: int = 200          # updates between adding a frozen copy to the league
    league_size: int = 20
    league_seat_frac: float = 0.3      # fraction of seats played by past snapshots
    # --- evaluation / bookkeeping --------------------------------------------
    eval_every: int = 250
    eval_hands: int = 3000             # per table size per opponent type
    eval_sizes: tuple = (2, 6, 13)
    log_every: int = 25
    checkpoint_minutes: float = 10.0
    train_hours: float = 11.5          # Colab sessions cap around 12 h
    save_dir: str = "/content/drive/MyDrive/poker_rl_server"   # falls back to ./poker_rl_server
    seed: int = 0


CFG = Config()

OBS_VERSION = "bayou-v1"     # bump when encode() changes; old checkpoints are then not resumed
MAX_SEATS = 20               # server's PokerEngine.MAX_PLAYERS
NUM_ACTIONS = 6              # fold, check/call, raise 0.5 pot, raise 1 pot, raise 2 pot, all-in
RAISE_FRACS = {2: 0.5, 3: 1.0, 4: 2.0}
ACTION_NAMES = ["fold", "call", "r0.5p", "r1p", "r2p", "allin"]
SUITS = ("hearts", "diamonds", "clubs", "spades")          # card int = (rank-2)*4 + suit index
PHASE_TO_STREET = {"PREFLOP": 0, "FLOP": 1, "TURN": 2, "RIVER": 3}


# ----------------------------------------------------------------------------
# 7-card hand evaluator (cards are ints 0..51: rank = c // 4 (0=2 .. 12=A), suit = c % 4)
# returns an int; higher is better. Works for 2..7 cards.
# ----------------------------------------------------------------------------
STRAIGHT_MASKS = [(0b11111 << (h - 4), h) for h in range(12, 3, -1)] + [(0b1000000001111, 3)]


def _straight_high(mask):
    for m, h in STRAIGHT_MASKS:
        if mask & m == m:
            return h
    return -1


def _score(cat, ranks):
    s = cat
    for i in range(5):
        s = s * 16 + (ranks[i] if i < len(ranks) else 0)
    return s


def eval_hand(cards):
    counts = [0] * 13
    suit_masks = [0, 0, 0, 0]
    suit_counts = [0, 0, 0, 0]
    rmask = 0
    for c in cards:
        r, s = c >> 2, c & 3
        counts[r] += 1
        suit_masks[s] |= 1 << r
        suit_counts[s] += 1
        rmask |= 1 << r
    flush_score = None
    for s in range(4):
        if suit_counts[s] >= 5:
            sm = suit_masks[s]
            h = _straight_high(sm)
            if h >= 0:
                return _score(8, [h])
            fr = [r for r in range(12, -1, -1) if sm >> r & 1][:5]
            flush_score = _score(5, fr)
            break
    quads, trips, pairs, singles = [], [], [], []
    for r in range(12, -1, -1):
        c = counts[r]
        if c == 4: quads.append(r)
        elif c == 3: trips.append(r)
        elif c == 2: pairs.append(r)
        elif c == 1: singles.append(r)
    if quads:
        kick = max([r for r in range(13) if counts[r] and r != quads[0]], default=0)
        return _score(7, [quads[0], kick])
    if trips and (len(trips) > 1 or pairs):
        pair = max(trips[1:] + pairs)
        return _score(6, [trips[0], pair])
    if flush_score is not None:
        return flush_score
    h = _straight_high(rmask)
    if h >= 0:
        return _score(4, [h])
    if trips:
        kick = sorted(trips[1:] + singles, reverse=True)[:2]
        return _score(3, [trips[0]] + kick)
    if len(pairs) >= 2:
        kick = max(pairs[2:] + singles[:1], default=0)
        return _score(2, [pairs[0], pairs[1], kick])
    if pairs:
        return _score(1, [pairs[0]] + singles[:3])
    return _score(0, singles[:5])


def hand_category(cards):
    return eval_hand(cards) >> 20  # 0 high card .. 8 straight flush


# ----------------------------------------------------------------------------
# View: everything the server's `state` message tells one player, in seat order of the
# players dealt into this hand. Built by Table.view() in training and by view_from_state()
# on the live server, then fed to the same encode() / legal_mask() / to_server_action().
# ----------------------------------------------------------------------------
class View:
    __slots__ = ("n", "me", "button", "sb", "bb", "hole", "board", "street", "pot", "current_bet",
                 "min_raise", "start_stack", "big_blind", "stack", "bet", "folded", "allin", "can_raise")

    def __init__(self, **kw):
        for k in self.__slots__:
            setattr(self, k, kw.get(k))


def view_from_state(state, my_id):
    """Convert a server `state` payload into a View for player `my_id`."""
    dealt = [p for p in state["players"] if p["hole_cards"]]       # join order == seat order
    ids = [p["id"] for p in dealt]
    me = ids.index(my_id)

    def card(c):
        return (int(c["rank"]) - 2) * 4 + SUITS.index(c["suit"])

    def idx(pid):
        return ids.index(pid) if pid in ids else -1

    return View(
        n=len(dealt), me=me, button=idx(state["dealer"]),
        sb=idx(state.get("small_blind_player")), bb=idx(state.get("big_blind_player")),
        hole=[card(c) for c in dealt[me]["hole_cards"]],
        board=[card(c) for c in state["community_cards"]],
        street=PHASE_TO_STREET[state["phase"]],
        pot=state["pot"], current_bet=state["current_bet"], min_raise=state["minimum_raise"],
        start_stack=state["starting_stack"], big_blind=state["big_blind"],
        stack=[p["stack"] for p in dealt], bet=[p["bet"] for p in dealt],
        folded=[p["folded"] for p in dealt], allin=[p["all_in"] for p in dealt],
        can_raise=None,   # the server does not reveal the short-all-in reopen state; bot falls back if rejected
    )


# ----------------------------------------------------------------------------
# Action space <-> server actions
# ----------------------------------------------------------------------------
def raise_target(v, a):
    """Street-total chips for abstract raise action a (2..5)."""
    i = v.me
    max_to = v.bet[i] + v.stack[i]
    if a == 5:
        return max_to
    call_amt = v.current_bet - v.bet[i]
    raise_by = max(int(RAISE_FRACS[a] * (v.pot + call_amt)), v.min_raise)
    return min(v.current_bet + raise_by, max_to)


def legal_mask(v):
    i = v.me
    m = np.zeros(NUM_ACTIONS, dtype=bool)
    call_amt = v.current_bet - v.bet[i]
    m[1] = True
    if call_amt > 0:
        m[0] = True
    others_can_act = any(not v.folded[j] and not v.allin[j] for j in range(v.n) if j != i)
    can_raise = True if v.can_raise is None else v.can_raise
    if v.stack[i] > call_amt and others_can_act and can_raise:
        max_to = v.bet[i] + v.stack[i]
        m[5] = True
        for a in (2, 3, 4):
            if raise_target(v, a) < max_to:
                m[a] = True
    return m


def to_server_action(v, a):
    """Abstract action -> (server action string, amount)."""
    if a == 0:
        return "fold", 0
    if a == 1:
        return ("check", 0) if v.current_bet == v.bet[v.me] else ("call", 0)
    return "raise", int(raise_target(v, a))


# ----------------------------------------------------------------------------
# Observation encoding
# ----------------------------------------------------------------------------
N_SCALARS = 14
N_OPP_FEAT = 9


def obs_dim():
    return (52 + 52 + 4 + N_SCALARS + MAX_SEATS + 3 + (MAX_SEATS - 1)
            + (MAX_SEATS - 1) * N_OPP_FEAT + 5 + 9 + 9 + 4)


def _draw_features(hole, board):
    """flush draw, straight draw, overcards to board, hole cards improve on the board."""
    if not board:
        return [0.0, 0.0, 0.0, 0.0]
    cards = hole + board
    fd = 0.0
    if len(board) < 5:
        for s in range(4):
            n_s = sum(1 for c in cards if c & 3 == s)
            if n_s == 4 and any(c & 3 == s for c in hole):
                fd = 1.0
    sd = 0.0
    rmask = 0
    for c in cards:
        rmask |= 1 << (c >> 2)
    if len(board) < 5 and _straight_high(rmask) < 0:
        ext = (rmask << 1) | (1 if rmask >> 12 & 1 else 0)          # bit 0 = ace low
        hole_bits = 0
        for c in hole:
            r = c >> 2
            hole_bits |= 1 << (r + 1)
            if r == 12:
                hole_bits |= 1
        for lo in range(0, 10):
            w = 0b11111 << lo
            if bin(ext & w).count("1") == 4 and ext & hole_bits & w:
                sd = 1.0
                break
    bmax = max(c >> 2 for c in board)
    over = sum(1 for c in hole if c >> 2 > bmax) / 2
    improves = float(hand_category(cards) > hand_category(board))
    return [fd, sd, over, improves]


def encode(v: View):
    n, i = v.n, v.me
    S = float(v.start_stack)
    bb = float(v.big_blind)
    x = np.zeros(obs_dim(), dtype=np.float32)
    o = 0
    for c in v.hole:
        x[o + c] = 1
    o += 52
    for c in v.board:
        x[o + c] = 1
    o += 52
    x[o + v.street] = 1
    o += 4

    call_amt = v.current_bet - v.bet[i]
    contrib = [S - s for s in v.stack]          # every hand starts at start_stack on the server
    pot = v.pot
    live = sum(1 for f in v.folded if not f)
    actors = sum(1 for j in range(n) if not v.folded[j] and not v.allin[j])
    facing = sum(1 for j in range(n) if j != i and not v.folded[j] and not v.allin[j] and v.bet[j] < v.current_bet)
    x[o:o + N_SCALARS] = [
        pot / S, call_amt / S, v.stack[i] / S, v.bet[i] / S, contrib[i] / S,
        v.current_bet / S, v.min_raise / S,
        call_amt / (pot + call_amt) if call_amt > 0 else 0.0,
        min(v.stack[i] / max(pot, 1), 10) / 10,
        math.log1p(pot / bb) / 5, math.log1p(call_amt / bb) / 5,
        live / n, actors / n, facing / n,
    ]
    o += N_SCALARS

    # position: seats from the button (0 = button), flags, and order postflop
    x[o + (v.button - i) % n] = 1
    o += MAX_SEATS
    pos = (i - v.button - 1) % n                # 0 = first to act postflop, n-1 = button
    x[o:o + 3] = [float(i == v.sb), float(i == v.bb), pos / max(n - 1, 1)]
    o += 3
    x[o + min(n, MAX_SEATS) - 2] = 1            # table size one-hot (2..20)
    o += MAX_SEATS - 1

    # opponents, clockwise from my left
    for k in range(1, min(n, MAX_SEATS)):
        j = (i + k) % n
        in_hand = not v.folded[j]
        x[o:o + N_OPP_FEAT] = [
            1.0, float(in_hand), float(v.allin[j]), v.stack[j] / S, v.bet[j] / S, contrib[j] / S,
            float(in_hand and v.bet[j] == v.current_bet),
            float((j - v.button - 1) % n > pos), float(j == v.button),
        ]
        o += N_OPP_FEAT
    o += (MAX_SEATS - min(n, MAX_SEATS)) * N_OPP_FEAT

    r1, r2 = sorted([c >> 2 for c in v.hole], reverse=True)
    suited = (v.hole[0] & 3) == (v.hole[1] & 3)
    x[o:o + 5] = [float(r1 == r2), float(suited), r1 / 12, r2 / 12, (r1 - r2) / 12]
    o += 5
    cat = hand_category(v.hole + v.board) if v.board else (1 if r1 == r2 else 0)
    x[o + cat] = 1
    o += 9
    if v.board:
        x[o + hand_category(v.board)] = 1
    o += 9
    x[o:o + 4] = _draw_features(v.hole, v.board)
    o += 4
    assert o == len(x)
    return x


# ----------------------------------------------------------------------------
# Training table: a copy of the server's PokerEngine rules (all seats connected),
# with integer seats 0..n-1 in server seat order.
# ----------------------------------------------------------------------------
class Table:
    def __init__(self, sb, bb, start_stack, rng):
        self.sb_amt, self.bb_amt = sb, bb
        self.start_stack = start_stack
        self.rng = rng
        self.done = True

    # --- hand setup -------------------------------------------------------
    def new_hand(self, n, button=None, deck=None, start_stack=None):
        self.n = n
        if start_stack is not None:
            self.start_stack = int(start_stack)
        self.button = int(self.rng.integers(n)) if button is None else button
        self.deck = list(deck) if deck is not None else self.rng.permutation(52).tolist()
        self.hole = [[] for _ in range(n)]
        for _ in range(2):                      # deal from left of the button; button last
            for k in range(1, n + 1):
                self.hole[(self.button + k) % n].append(self.deck.pop())
        self.board = []
        self.stack = [self.start_stack] * n
        self.bet = [0] * n
        self.contrib = [0] * n
        self.folded = [False] * n
        self.allin = [False] * n
        self.street = 0
        self.done = False
        self.result = None
        self.round_acted, self.acted_at = set(), {}
        self.current_bet, self.min_raise = 0, self.bb_amt
        if n == 2:
            self.sb_seat, self.bb_seat = self.button, (self.button + 1) % n
        else:
            self.sb_seat, self.bb_seat = (self.button + 1) % n, (self.button + 2) % n
        self._commit(self.sb_seat, self.sb_amt)
        self._commit(self.bb_seat, self.bb_amt)
        self.current_bet = self.bb_amt
        self.cur = self._next_actor(self.bb_seat)
        self._finish_if_ready()

    def _commit(self, i, amt):
        amt = min(amt, self.stack[i])
        self.stack[i] -= amt
        self.bet[i] += amt
        self.contrib[i] += amt
        if self.stack[i] == 0:
            self.allin[i] = True

    @property
    def pot(self):
        return sum(self.contrib)

    def _can_act(self, i):
        return not self.folded[i] and not self.allin[i]

    def _next_actor(self, start):
        for k in range(1, self.n + 1):
            j = (start + k) % self.n
            if self._can_act(j):
                return j
        return None

    def can_raise(self, i):
        if not any(self._can_act(j) for j in range(self.n) if j != i):
            return False
        faced = self.acted_at.get(i)
        return not (faced is not None and faced > 0 and self.current_bet - faced < self.min_raise)

    def view(self, i):
        return View(n=self.n, me=i, button=self.button, sb=self.sb_seat, bb=self.bb_seat,
                    hole=self.hole[i], board=self.board, street=self.street, pot=self.pot,
                    current_bet=self.current_bet, min_raise=self.min_raise,
                    start_stack=self.start_stack, big_blind=self.bb_amt,
                    stack=self.stack, bet=self.bet, folded=self.folded, allin=self.allin,
                    can_raise=self.can_raise(i))

    # --- stepping (mirror of PokerEngine.place_action) -------------------
    def apply(self, action, amount=0):
        """Apply a server-style action for the current player. Returns an error string or None."""
        i = self.cur
        if action == "fold":
            self.folded[i] = True
        elif action == "check":
            if self.bet[i] != self.current_bet:
                return "Cannot check while facing a bet"
        elif action == "call":
            self._commit(i, self.current_bet - self.bet[i])
        elif action in ("raise", "bet"):
            if action == "bet" and self.current_bet != 0:
                return "Use raise when facing an existing bet"
            if not any(self._can_act(j) for j in range(self.n) if j != i):
                return "Cannot bet or raise against only all-in opponents"
            if amount <= self.current_bet:
                return "Raise target must exceed the current bet"
            if amount > self.bet[i] + self.stack[i]:
                return "Raise exceeds available stack"
            raise_size = amount - self.current_bet
            is_all_in = amount == self.bet[i] + self.stack[i]
            if raise_size < self.min_raise and not is_all_in:
                return f"Raise must increase the bet by at least {self.min_raise}"
            faced = self.acted_at.get(i)
            if faced is not None and faced > 0 and self.current_bet - faced < self.min_raise:
                return "A short all-in did not reopen raising"
            self._commit(i, amount - self.bet[i])
            self.current_bet = self.bet[i]
            if raise_size >= self.min_raise:
                self.min_raise = raise_size
                self.round_acted = {i}
        else:
            return "Invalid action"
        self.round_acted.add(i)
        self.acted_at[i] = self.current_bet
        street_before = self.street
        self._finish_if_ready()
        if not self.done and self.street == street_before:
            self.cur = self._next_actor(i)
            self._finish_if_ready()
        return None

    def _round_complete(self):
        contenders = [j for j in range(self.n) if not self.folded[j]]
        if len(contenders) <= 1:
            return True
        actors = [j for j in contenders if not self.allin[j]]
        if len(actors) <= 1:
            return not actors or self.bet[actors[0]] >= max(self.bet[j] for j in contenders)
        return all(self.allin[j] or (j in self.round_acted and self.bet[j] == self.current_bet)
                   for j in contenders)

    def _finish_if_ready(self):
        while not self.done and self._round_complete():
            self._return_uncalled_bet()
            if sum(1 for f in self.folded if not f) <= 1:
                self._resolve()
                return
            self._advance()

    def _return_uncalled_bet(self):
        top = max(self.bet)
        rest = sorted(self.bet, reverse=True)[1] if self.n > 1 else 0
        excess = top - rest
        if excess:
            j = self.bet.index(top)
            self.bet[j] -= excess
            self.contrib[j] -= excess
            self.stack[j] += excess
            self.allin[j] = False

    def _advance(self):
        if self.street == 3:
            self._resolve()
            return
        self.street += 1
        self.round_acted, self.acted_at = set(), {}
        self.current_bet, self.min_raise = 0, self.bb_amt
        self.bet = [0] * self.n
        self.deck.pop()                                     # burn
        self.board += [self.deck.pop() for _ in range(3 if self.street == 1 else 1)]
        self.cur = self._next_actor(self.button)

    def _resolve(self):
        n = self.n
        contenders = [j for j in range(n) if not self.folded[j]]
        pay = [0] * n
        if len(contenders) <= 1:
            if contenders:
                pay[contenders[0]] = self.pot
        else:
            scores = {j: eval_hand(self.hole[j] + self.board) for j in contenders}
            order = [(self.button + k) % n for k in range(1, n + 1)]
            prev = 0
            for level in sorted(set(c for c in self.contrib if c)):
                layer = (level - prev) * sum(1 for c in self.contrib if c >= level)
                elig = [j for j in contenders if self.contrib[j] >= level]
                if elig:
                    best = max(scores[j] for j in elig)
                    winners = [j for j in elig if scores[j] == best]
                    share, rem = divmod(layer, len(winners))
                    for w in winners:
                        pay[w] += share
                    for w in [j for j in order if j in winners][:rem]:
                        pay[w] += 1
                prev = level
        for j in range(n):
            self.stack[j] += pay[j]
        self.payouts = pay
        self.result = [(pay[j] - self.contrib[j]) / self.bb_amt for j in range(n)]   # in BB
        self.done = True
        self.cur = None

    # --- server-format snapshot (used by the self-test to check the bot's adapter) ----
    def server_state(self, i, ids):
        def card(c):
            return {"rank": c // 4 + 2, "suit": SUITS[c % 4], "label": "x"}
        hidden = {"rank": "?", "suit": "?", "label": "??"}
        players = [{"id": ids[j], "name": ids[j], "stack": self.stack[j], "bet": self.bet[j],
                    "folded": self.folded[j], "all_in": self.allin[j], "connected": True,
                    "hole_cards": [card(c) for c in self.hole[j]] if j == i else [hidden, hidden],
                    "profit_loss": 0, "hands_played": 0} for j in range(self.n)]
        return {"phase": ["PREFLOP", "FLOP", "TURN", "RIVER"][self.street], "pot": self.pot,
                "community_cards": [card(c) for c in self.board], "players": players,
                "current_turn": ids[self.cur], "dealer": ids[self.button],
                "small_blind_player": ids[self.sb_seat], "big_blind_player": ids[self.bb_seat],
                "current_bet": self.current_bet, "minimum_raise": self.min_raise,
                "starting_stack": self.start_stack, "big_blind": self.bb_amt,
                "small_blind": self.sb_amt}


# ----------------------------------------------------------------------------
# Network
# ----------------------------------------------------------------------------
class PolicyNet(nn.Module):
    def __init__(self, in_dim, hidden):
        super().__init__()
        self.body = nn.Sequential(
            nn.Linear(in_dim, hidden), nn.LayerNorm(hidden), nn.GELU(),
            nn.Linear(hidden, hidden), nn.LayerNorm(hidden), nn.GELU(),
            nn.Linear(hidden, hidden // 2), nn.LayerNorm(hidden // 2), nn.GELU(),
        )
        self.pi = nn.Linear(hidden // 2, NUM_ACTIONS)
        self.v = nn.Linear(hidden // 2, 1)

    def forward(self, x, mask):
        h = self.body(x)
        logits = self.pi(h).masked_fill(~mask, -1e9)
        return logits, self.v(h).squeeze(-1)


def save_policy(net, path, hidden):
    torch.save({"version": OBS_VERSION, "obs_dim": obs_dim(), "hidden": hidden,
                "state_dict": {k: v.detach().cpu() for k, v in net.state_dict().items()}}, path)


def load_policy(path, device="cpu"):
    d = torch.load(path, map_location=device, weights_only=False)
    if not isinstance(d, dict) or d.get("version") != OBS_VERSION:
        raise SystemExit(f"{path} was not saved by this version of the script ({OBS_VERSION}); retrain.")
    net = PolicyNet(d["obs_dim"], d["hidden"]).to(device)
    net.load_state_dict(d["state_dict"])
    net.eval()
    return net


# ----------------------------------------------------------------------------
# Baseline bots for evaluation (choose an abstract action from the legal mask)
# ----------------------------------------------------------------------------
def random_bot(mask, rng):
    return int(rng.choice(np.flatnonzero(mask)))


def calling_station(mask, rng):
    return 1


# ----------------------------------------------------------------------------
# Trainer
# ----------------------------------------------------------------------------
class Trainer:
    def __init__(self, cfg: Config):
        self.cfg = cfg
        random.seed(cfg.seed); np.random.seed(cfg.seed); torch.manual_seed(cfg.seed)
        self.device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        self.rng = np.random.default_rng(cfg.seed)
        self.dim = obs_dim()
        self.net = PolicyNet(self.dim, cfg.hidden).to(self.device)
        self.opt = torch.optim.Adam(self.net.parameters(), lr=cfg.lr)
        self.league = []          # CPU state_dicts of frozen past policies
        self.league_nets = []
        self.updates = self.hands = self.decisions = 0
        self.elapsed = 0.0
        self.save_dir = self._pick_save_dir()
        self.ckpt_path = os.path.join(self.save_dir, "checkpoint.pt")
        self.policy_path = os.path.join(self.save_dir, "policy_latest.pt")
        self.log_path = os.path.join(self.save_dir, "log.csv")
        self._resume()
        self.tables = [Table(cfg.small_blind, cfg.big_blind, cfg.starting_stacks[0],
                             np.random.default_rng(cfg.seed + 1000 + k + self.hands))
                       for k in range(cfg.num_tables)]
        self.seat_role = [[] for _ in self.tables]     # -1 = current policy, k = league[k]
        self.traj = [[] for _ in self.tables]
        self.buf_obs, self.buf_mask, self.buf_act, self.buf_ret = [], [], [], []
        self._reset_stats()
        for k in range(len(self.tables)):
            self._start_hand(k)

    def _reset_stats(self):
        self.stats = {"act": np.zeros(NUM_ACTIONS), "vpip": 0, "pf_decisions": 0}

    # --- persistence --------------------------------------------------------
    def _pick_save_dir(self):
        d = self.cfg.save_dir
        if not os.path.isdir(os.path.dirname(d.rstrip("/")) or "/"):
            d = "./poker_rl_server"
        os.makedirs(d, exist_ok=True)
        return d

    def save(self):
        state = {"version": OBS_VERSION, "net": self.net.state_dict(), "opt": self.opt.state_dict(),
                 "league": self.league, "updates": self.updates, "hands": self.hands,
                 "decisions": self.decisions, "elapsed": self.elapsed, "cfg": asdict(self.cfg)}
        tmp = self.ckpt_path + ".tmp"
        torch.save(state, tmp)
        os.replace(tmp, self.ckpt_path)
        save_policy(self.net, self.policy_path, self.cfg.hidden)

    def _resume(self):
        if not os.path.exists(self.ckpt_path):
            print(f"Starting fresh. Saving to {self.save_dir}")
            return
        s = torch.load(self.ckpt_path, map_location=self.device, weights_only=False)
        if s.get("version") != OBS_VERSION or s["cfg"].get("hidden") != self.cfg.hidden:
            old = self.ckpt_path + ".incompatible"
            os.replace(self.ckpt_path, old)
            print(f"Checkpoint is from a different script version or network size; moved to {old}. Starting fresh.")
            return
        self.net.load_state_dict(s["net"]); self.opt.load_state_dict(s["opt"])
        self.league = s["league"]
        for sd in self.league:
            self._add_league_net(sd)
        self.updates, self.hands = s["updates"], s["hands"]
        self.decisions, self.elapsed = s["decisions"], s["elapsed"]
        print(f"Resumed from {self.ckpt_path}: {self.updates} updates, {self.hands:,} hands, "
              f"{self.elapsed / 3600:.2f} h trained")

    def _add_league_net(self, sd):
        net = PolicyNet(self.dim, self.cfg.hidden).to(self.device)
        net.load_state_dict(sd); net.eval()
        self.league_nets.append(net)

    def add_snapshot(self):
        sd = {k: v.detach().cpu().clone() for k, v in self.net.state_dict().items()}
        self.league.append(sd)
        self._add_league_net(sd)
        if len(self.league) > self.cfg.league_size:
            self.league.pop(0); self.league_nets.pop(0)

    # --- self-play ------------------------------------------------------------
    def _start_hand(self, k):
        c = self.cfg
        while True:
            t = self.tables[k]
            n = int(self.rng.integers(c.min_players, c.max_players + 1))
            t.new_hand(n, start_stack=c.starting_stacks[self.rng.integers(len(c.starting_stacks))])
            if self.league_nets:
                snap = int(self.rng.integers(len(self.league_nets)))
                roles = [snap if self.rng.random() < c.league_seat_frac else -1 for _ in range(n)]
                if all(r != -1 for r in roles):
                    roles[self.rng.integers(n)] = -1
            else:
                roles = [-1] * n
            self.seat_role[k] = roles
            self.traj[k] = [[] for _ in range(n)]
            if not t.done:      # a hand can only end during setup in degenerate (tiny-stack) configs
                return
            self.hands += 1

    def _finish_hand(self, k):
        t = self.tables[k]
        for seat, steps in enumerate(self.traj[k]):
            if self.seat_role[k][seat] != -1:
                continue
            R = t.result[seat]
            for (o, m, a) in steps:
                self.buf_obs.append(o); self.buf_mask.append(m); self.buf_act.append(a); self.buf_ret.append(R)
        self.hands += 1
        self._start_hand(k)

    @torch.no_grad()
    def _act(self, net, obs, masks, greedy=False):
        x = torch.as_tensor(np.stack(obs), device=self.device)
        m = torch.as_tensor(np.stack(masks), device=self.device)
        logits, _ = net(x, m)
        if greedy:
            return logits.argmax(-1).cpu().numpy()
        return torch.distributions.Categorical(logits=logits).sample().cpu().numpy()

    def play_step(self):
        groups = {}
        for k, t in enumerate(self.tables):
            i = t.cur
            v = t.view(i)
            groups.setdefault(self.seat_role[k][i], []).append((k, i, v, encode(v), legal_mask(v)))
        for role, items in groups.items():
            net = self.net if role == -1 else self.league_nets[role]
            acts = self._act(net, [x[3] for x in items], [x[4] for x in items])
            for (k, i, v, o, m), a in zip(items, acts):
                a = int(a)
                t = self.tables[k]
                if role == -1:
                    self.traj[k][i].append((o, m, a))
                    self.decisions += 1
                    self.stats["act"][a] += 1
                    if t.street == 0:
                        self.stats["pf_decisions"] += 1
                        self.stats["vpip"] += int(a >= 2 or (a == 1 and t.current_bet > t.bet[i]))
                err = t.apply(*to_server_action(v, a))
                assert err is None, f"engine rejected {ACTION_NAMES[a]}: {err}"
                if t.done:
                    self._finish_hand(k)

    # --- learning -------------------------------------------------------------
    def entropy_coef(self):
        c = self.cfg
        f = min(1.0, self.updates / c.entropy_decay_updates)
        return c.entropy_coef + f * (c.entropy_coef_final - c.entropy_coef)

    def update(self):
        c = self.cfg
        obs = torch.as_tensor(np.stack(self.buf_obs), device=self.device)
        mask = torch.as_tensor(np.stack(self.buf_mask), device=self.device)
        act = torch.as_tensor(np.array(self.buf_act), device=self.device)
        ret = torch.as_tensor(np.array(self.buf_ret, dtype=np.float32), device=self.device) / c.return_scale
        self.buf_obs, self.buf_mask, self.buf_act, self.buf_ret = [], [], [], []
        N = len(act)
        with torch.no_grad():
            _, v_old = self.net(obs, mask)
            adv = ret - v_old
            adv = (adv - adv.mean()) / (adv.std() + 1e-8)
        perm = torch.randperm(N, device=self.device)
        ent_c = self.entropy_coef()
        tot = {"pi": 0.0, "v": 0.0, "ent": 0.0}
        nb = 0
        for s in range(0, N, c.minibatch):
            idx = perm[s:s + c.minibatch]
            logits, v = self.net(obs[idx], mask[idx])
            logp_all = F.log_softmax(logits, -1)
            logp = logp_all.gather(1, act[idx, None]).squeeze(1)
            probs = logp_all.exp()
            ent = -(probs * logp_all.masked_fill(~mask[idx], 0)).sum(-1).mean()
            pi_loss = -(logp * adv[idx]).mean()
            v_loss = F.smooth_l1_loss(v, ret[idx])
            loss = pi_loss + c.value_coef * v_loss - ent_c * ent
            self.opt.zero_grad(set_to_none=True)
            loss.backward()
            nn.utils.clip_grad_norm_(self.net.parameters(), c.grad_clip)
            self.opt.step()
            tot["pi"] += pi_loss.item(); tot["v"] += v_loss.item(); tot["ent"] += ent.item(); nb += 1
        self.updates += 1
        return {k: v / nb for k, v in tot.items()}

    # --- evaluation -------------------------------------------------------------
    @torch.no_grad()
    def evaluate(self, bot, hands, n):
        """Current policy in seat 0 vs (n-1) bots at an n-handed table. Returns bb/100 and SE."""
        self.net.eval()
        rng = np.random.default_rng(12345)
        c = self.cfg
        tables = [Table(c.small_blind, c.big_blind, c.starting_stacks[0], np.random.default_rng(777 + k))
                  for k in range(64)]
        results = []
        for t in tables:
            t.new_hand(n)
        while len(results) < hands:
            hero = []
            for k, t in enumerate(tables):
                while not t.done and t.cur != 0:
                    v = t.view(t.cur)
                    t.apply(*to_server_action(v, bot(legal_mask(v), rng)))
                if t.done:
                    results.append(t.result[0]); t.new_hand(n)
                    continue
                v = t.view(0)
                hero.append((k, v, encode(v), legal_mask(v)))
            if hero:
                acts = self._act(self.net, [x[2] for x in hero], [x[3] for x in hero])
                for (k, v, _, _), a in zip(hero, acts):
                    t = tables[k]
                    t.apply(*to_server_action(v, int(a)))
                    if t.done:
                        results.append(t.result[0]); t.new_hand(n)
        self.net.train()
        r = np.array(results[:hands])
        return 100 * r.mean(), 100 * r.std() / math.sqrt(len(r))

    # --- main loop --------------------------------------------------------------
    def log_row(self, row):
        new = not os.path.exists(self.log_path)
        with open(self.log_path, "a", newline="") as f:
            w = csv.DictWriter(f, fieldnames=list(row.keys()))
            if new:
                w.writeheader()
            w.writerow(row)

    def train(self):
        c = self.cfg
        print(f"device={self.device}  players={c.min_players}-{c.max_players}  tables={c.num_tables}  "
              f"obs_dim={self.dim}  stack={c.starting_stacks} blinds={c.small_blind}/{c.big_blind}")
        t_start = time.time()
        elapsed0 = self.elapsed
        last_ckpt = time.time()
        last_log_t, last_log_h = time.time(), self.hands
        try:
            while self.elapsed < c.train_hours * 3600:
                while len(self.buf_act) < c.batch_decisions:
                    self.play_step()
                losses = self.update()
                self.elapsed = elapsed0 + (time.time() - t_start)

                if self.updates % c.snapshot_every == 0:
                    self.add_snapshot()

                if self.updates % c.log_every == 0:
                    now = time.time()
                    hps = (self.hands - last_log_h) / (now - last_log_t)
                    last_log_t, last_log_h = now, self.hands
                    a = self.stats["act"] / max(1, self.stats["act"].sum())
                    vpip = self.stats["vpip"] / max(1, self.stats["pf_decisions"])
                    dist = " ".join(f"{n}:{p:.2f}" for n, p in zip(ACTION_NAMES, a))
                    print(f"[{self.elapsed / 3600:5.2f}h] upd {self.updates:6d} | hands {self.hands:,} "
                          f"({hps:.0f}/s) | ent {losses['ent']:.3f} vloss {losses['v']:.4f} | "
                          f"pf-VPIP {vpip:.2f} | {dist}")
                    self.log_row({"hours": round(self.elapsed / 3600, 3), "updates": self.updates,
                                  "hands": self.hands, "entropy": losses["ent"], "v_loss": losses["v"],
                                  "pi_loss": losses["pi"], "vpip": vpip,
                                  **{f"p_{n}": p for n, p in zip(ACTION_NAMES, a)}})
                    self._reset_stats()

                if self.updates % c.eval_every == 0:
                    for n in c.eval_sizes:
                        for name, bot in (("random", random_bot), ("caller", calling_station)):
                            m, se = self.evaluate(bot, c.eval_hands, n)
                            print(f"    eval {n:2d}-handed vs {name:7s}: {m:+8.1f} ± {se:.1f} bb/100")
                            self.log_row({"hours": round(self.elapsed / 3600, 3), "updates": self.updates,
                                          "hands": self.hands, f"eval_{n}p_{name}_bb100": m,
                                          f"eval_{n}p_{name}_se": se})

                if time.time() - last_ckpt > c.checkpoint_minutes * 60:
                    self.save(); last_ckpt = time.time()
                    print(f"    checkpoint saved -> {self.ckpt_path}")
        except KeyboardInterrupt:
            print("Interrupted; saving checkpoint...")
        self.save()
        print(f"Done. {self.hands:,} hands, {self.updates} updates.\n"
              f"Bot policy for the server: {self.policy_path}")


# ----------------------------------------------------------------------------
# Live bot for the Bayou Poker server
# ----------------------------------------------------------------------------
def choose_action(net, state, my_id, greedy=False):
    v = view_from_state(state, my_id)
    m = legal_mask(v)
    x = torch.as_tensor(encode(v))[None]
    with torch.no_grad():
        logits, _ = net(x, torch.as_tensor(m)[None])
    a = int(logits.argmax(-1)) if greedy else int(torch.distributions.Categorical(logits=logits).sample())
    return to_server_action(v, a), a


def _safe_action(state, my_id):
    me = next(p for p in state["players"] if p["id"] == my_id)
    return "check" if me["bet"] == state["current_bet"] else "call"


async def run_bot(player_id, url, policy_path, name=None, greedy=False):
    import websockets
    torch.set_num_threads(1)
    net = load_policy(policy_path)
    print(f"Loaded {policy_path}; connecting to {url} as {player_id}", flush=True)
    while True:
        try:
            async with websockets.connect(url, ping_interval=20) as ws:
                await ws.send(json.dumps({"type": "join", "player_id": player_id, "name": name or player_id}))
                pending, last_turn, turn_state, failures, match = False, None, None, 0, None
                async for raw in ws:
                    msg = json.loads(raw)
                    kind = msg.get("type")
                    if kind == "error":
                        print("Server error:", msg.get("message"), flush=True)
                        pending = False
                    elif kind == "action_result":
                        pending = False
                        if not msg["payload"]["ok"]:
                            failures += 1
                            print("Rejected:", msg["payload"]["error"], flush=True)
                            if turn_state is not None and failures <= 2:
                                # 1st rejection: check/call (always legal); 2nd: fold
                                fb = _safe_action(turn_state, player_id) if failures == 1 else "fold"
                                await ws.send(json.dumps({"type": "action", "action": fb}))
                                pending = True
                    elif kind == "state":
                        st = msg["payload"]
                        if st.get("match_number") != match:
                            match = st.get("match_number")
                            print(f"Match {match}", flush=True)
                        if st["phase"] == "WAITING" and st.get("hands_completed"):
                            me = next((p for p in st["players"] if p["id"] == player_id), None)
                            if me and st["hands_completed"] != getattr(run_bot, "_last_hc", None):
                                run_bot._last_hc = st["hands_completed"]
                                print(f"  hand {st['hands_completed']}/{st['max_hands']}  "
                                      f"profit {me['profit_loss']:+d}", flush=True)
                        if pending or st["current_turn"] != player_id:
                            continue
                        turn = (st["match_number"], st["hand_number"], st["phase"], st["current_bet"],
                                len(st["community_cards"]),
                                tuple((p["id"], p["bet"], p["stack"], p["folded"], p["all_in"])
                                      for p in st["players"]))
                        if turn == last_turn:
                            continue
                        try:
                            (action, amount), a = choose_action(net, st, player_id, greedy)
                        except Exception as e:      # never time out because of a bug: play safe
                            print("Policy error, playing check/call:", repr(e), flush=True)
                            action, amount = _safe_action(st, player_id), 0
                        out = {"type": "action", "action": action}
                        if action == "raise":
                            out["amount"] = amount
                        await ws.send(json.dumps(out))
                        pending, last_turn, turn_state, failures = True, turn, st, 0
        except websockets.ConnectionClosed as e:
            if getattr(e, "rcvd", None) is not None and e.rcvd.code == 4001:
                print("Another connection took over this player id; exiting.", flush=True)
                return
            print("Connection closed; reconnecting in 2 s", flush=True)
        except OSError as e:
            print(f"Cannot connect ({e}); retrying in 2 s", flush=True)
        await asyncio.sleep(2)


# ----------------------------------------------------------------------------
# Self-tests (about 10 seconds)
# ----------------------------------------------------------------------------
def _self_test():
    C = lambda s: "23456789TJQKA".index(s[0]) * 4 + "cdhs".index(s[1])
    h = lambda *xs: eval_hand([C(x) for x in xs])
    assert h("As", "Ks", "Qs", "Js", "Ts", "2d", "3c") > h("9s", "9d", "9h", "9c", "Ad", "2c", "3h")
    assert h("Ah", "2d", "3c", "4s", "5h", "Kd", "Kc") >> 20 == 4
    assert h("Kh", "Kd", "Kc", "2s", "2h", "2d", "As") >> 20 == 6
    assert h("Ah", "Ad", "Kc", "Ks", "Qh", "Qd", "2c") > h("Ah", "Ad", "Kc", "Ks", "Jh", "Jd", "2c")
    rng = np.random.default_rng(0)
    t = Table(10, 20, 1000, rng)
    for n in range(2, 14):
        ids = [f"p{j}" for j in range(n)]
        for hand in range(400):
            t.new_hand(n)
            while not t.done:
                i = t.cur
                v = t.view(i)
                m = legal_mask(v)
                # the bot's adapter must see exactly what training sees
                v2 = view_from_state(t.server_state(i, ids), ids[i])
                assert np.array_equal(encode(v), encode(v2)), "server adapter encodes differently"
                assert np.array_equal(m & legal_mask(v2), m)
                a = int(rng.choice(np.flatnonzero(m)))
                err = t.apply(*to_server_action(v, a))
                assert err is None, err
            assert sum(t.payouts) == t.pot and sum(t.contrib) == t.pot, "chips not conserved"
            assert all(s >= 0 for s in t.stack)
    print("engine self-test passed")


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "play":
        p = argparse.ArgumentParser(prog="poker_selfplay.py play")
        p.add_argument("player_id")
        p.add_argument("url", nargs="?", default="ws://localhost:8000/ws")
        p.add_argument("--policy", default="policy_latest.pt")
        p.add_argument("--name", default=None)
        p.add_argument("--greedy", action="store_true")
        a = p.parse_args(argv[1:])
        try:
            asyncio.run(run_bot(a.player_id, a.url, a.policy, a.name, a.greedy))
        except KeyboardInterrupt:
            pass
    elif argv and argv[0] == "selftest":
        _self_test()
    else:   # default (also what happens when pasted into a Colab cell)
        _self_test()
        Trainer(CFG).train()


if __name__ == "__main__":
    main()
